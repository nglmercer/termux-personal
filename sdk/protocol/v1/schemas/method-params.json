{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:termux-personal:control:v1:method-params",
  "title": "v1 method-specific parameter shapes",
  "description": "Select the definition named by the method. The server additionally applies authorization, state, byte and parser limits.",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64},
    "name": {"type": "string", "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
    "columns": {"type": "integer", "minimum": 2, "maximum": 500},
    "rows": {"type": "integer", "minimum": 2, "maximum": 250},
    "cell": {"type": "integer", "minimum": 0, "maximum": 4096},
    "system.hello": {"type": "object", "properties": {"version": {"const": 1}}, "required": ["version"], "additionalProperties": false},
    "system.capabilities": {"type": "object", "maxProperties": 0},
    "system.describe": {"type": "object", "maxProperties": 0},
    "session.list": {"type": "object", "maxProperties": 0},
    "session.create": {
      "type": "object", "properties": {"name": {"$ref": "#/$defs/name"}, "columns": {"$ref": "#/$defs/columns"}, "rows": {"$ref": "#/$defs/rows"}, "cellWidth": {"$ref": "#/$defs/cell"}, "cellHeight": {"$ref": "#/$defs/cell"}},
      "required": ["columns", "rows"], "additionalProperties": false
    },
    "session.write": {"type": "object", "properties": {"id": {"$ref": "#/$defs/id"}, "length": {"type": "integer", "minimum": 1, "maximum": 65536}}, "required": ["id", "length"], "additionalProperties": false},
    "session.rename": {"type": "object", "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/name"}}, "required": ["id", "name"], "additionalProperties": false},
    "session.resize": {
      "type": "object", "properties": {"id": {"$ref": "#/$defs/id"}, "columns": {"$ref": "#/$defs/columns"}, "rows": {"$ref": "#/$defs/rows"}, "cellWidth": {"$ref": "#/$defs/cell"}, "cellHeight": {"$ref": "#/$defs/cell"}},
      "required": ["id", "columns", "rows"], "additionalProperties": false
    },
    "session.focus": {"$ref": "#/$defs/idParams"},
    "session.snapshot": {"$ref": "#/$defs/idParams"},
    "session.close": {"$ref": "#/$defs/idParams"},
    "session.output.unsubscribe": {"$ref": "#/$defs/idParams"},
    "idParams": {"type": "object", "properties": {"id": {"$ref": "#/$defs/id"}}, "required": ["id"], "additionalProperties": false},
    "session.output.subscribe": {"type": "object", "properties": {"id": {"$ref": "#/$defs/id"}, "resumable": {"type": "boolean"}}, "required": ["id"], "additionalProperties": false},
    "session.output.resume": {"type": "object", "properties": {"id": {"$ref": "#/$defs/id"}, "token": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "required": ["id", "token"], "additionalProperties": false},
    "session.output.read": {"type": "object", "properties": {"id": {"$ref": "#/$defs/id"}, "offset": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 65536}}, "required": ["id", "offset", "limit"], "additionalProperties": false},
    "jobId": {"type": "string", "minLength": 1, "maxLength": 128},
    "jobResources": {
      "type": "object", "properties": {
        "profile": {"enum": ["unrestricted", "protected", "balanced", "performance", "custom", null]},
        "memorySoftBytes": {"type": ["integer", "null"], "minimum": 16777216, "maximum": 1099511627776},
        "addressSpaceBytes": {"type": ["integer", "null"], "minimum": 67108864, "maximum": 1099511627776},
        "cpuTimeSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 2592000},
        "maxOutputBytes": {"type": ["integer", "null"], "minimum": 1024, "maximum": 262144},
        "processConcurrencyHint": {"type": ["integer", "null"], "minimum": 1, "maximum": 16},
        "niceLevel": {"type": ["integer", "null"], "minimum": 0, "maximum": 19},
        "onPressure": {"enum": ["warn", "pause_admission", "stop_job", null]},
        "requireNice": {"type": "boolean"},
        "applyBuildPreset": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
    "job.start": {
      "type": "object", "properties": {
        "executable": {"type": "string", "minLength": 1, "maxLength": 4096},
        "args": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 4096}},
        "cwd": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
        "workspaceId": {"type": "string", "minLength": 1, "maxLength": 64},
        "env": {"type": "object", "maxProperties": 64, "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}, "additionalProperties": {"type": "string", "maxLength": 4096}},
        "stdin": {"type": "string", "maxLength": 65536},
        "timeoutMs": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "presentation": {"enum": ["foreground", "background"]},
        "clientRequestId": {"$ref": "#/$defs/requestId"},
        "resources": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/jobResources"}]}
      },
      "required": ["executable", "args"], "additionalProperties": false
    },
    "job.list": {"type": "object", "properties": {"workspaceId": {"type": "string", "minLength": 1, "maxLength": 64}, "cursor": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 32}}, "additionalProperties": false},
    "job.get": {"type": "object", "properties": {"id": {"$ref": "#/$defs/jobId"}}, "required": ["id"], "additionalProperties": false},
    "job.output.read": {
      "type": "object", "properties": {"id": {"$ref": "#/$defs/jobId"}, "stream": {"enum": ["stdout", "stderr"]}, "offset": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 65536}},
      "required": ["id", "stream", "offset", "limit"], "additionalProperties": false
    },
    "job.cancel": {"type": "object", "properties": {"id": {"$ref": "#/$defs/jobId"}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["id"], "additionalProperties": false},
    "process.list": {"type": "object", "properties": {"scope": {"enum": ["owned", "session", "task", "all-visible"]}, "cursor": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}}, "additionalProperties": false},
    "process.signal": {"type": "object", "properties": {"jobId": {"$ref": "#/$defs/jobId"}, "signal": {"enum": ["TERM", "KILL", "INT"]}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["jobId", "signal"], "additionalProperties": false},
    "rootId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "filePath": {"type": "string", "maxLength": 4096, "pattern": "^(?:|(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$)[^\\u0000-\\u001f\\u007f\\\\]+)$"},
    "file.roots": {"type": "object", "maxProperties": 0},
    "file.list": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "cursor": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}}, "required": ["rootId"], "additionalProperties": false},
    "file.stat": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}}, "required": ["rootId", "path"], "additionalProperties": false},
    "file.read": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "offset": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 65536}}, "required": ["rootId", "path", "offset", "limit"], "additionalProperties": false},
    "file.mkdir": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["rootId", "path"], "additionalProperties": false},
    "file.rename": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "newPath": {"$ref": "#/$defs/filePath"}, "ifRevision": {"type": "string", "minLength": 1, "maxLength": 64}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["rootId", "path", "newPath"], "additionalProperties": false},
    "file.delete": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "ifRevision": {"type": "string", "minLength": 1, "maxLength": 64}, "recursive": {"const": false}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["rootId", "path"], "additionalProperties": false},
    "file.transfer.begin": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "totalBytes": {"type": "integer", "minimum": 0, "maximum": 2147483648}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ifRevision": {"type": "string", "minLength": 1, "maxLength": 64}, "overwrite": {"type": "boolean"}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["rootId", "path", "totalBytes"], "additionalProperties": false},
    "file.transfer.write": {"type": "object", "properties": {"transferId": {"type": "string", "pattern": "^tr_[0-9a-f]{32}$"}, "offset": {"type": "integer", "minimum": 0}, "length": {"type": "integer", "minimum": 1, "maximum": 65536}}, "required": ["transferId", "offset", "length"], "additionalProperties": false},
    "file.transfer.commit": {"type": "object", "properties": {"transferId": {"type": "string", "pattern": "^tr_[0-9a-f]{32}$"}}, "required": ["transferId"], "additionalProperties": false},
    "file.transfer.abort": {"type": "object", "properties": {"transferId": {"type": "string", "pattern": "^tr_[0-9a-f]{32}$"}}, "required": ["transferId"], "additionalProperties": false},
    "rootId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "filePath": {"type": "string", "maxLength": 4096, "pattern": "^(?:|(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$)[^\\u0000-\\u001f\\u007f\\\\]+)$"},
    "file.roots": {"type": "object", "maxProperties": 0},
    "file.list": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "cursor": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}}, "required": ["rootId"], "additionalProperties": false},
    "file.stat": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}}, "required": ["rootId", "path"], "additionalProperties": false},
    "file.read": {"type": "object", "properties": {"rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "offset": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 65536}}, "required": ["rootId", "path", "offset", "limit"], "additionalProperties": false},
    "wsId": {"type": "string", "pattern": "^ws_[0-9a-f]{16}$"},
    "presetId": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"},
    "workspaceName": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},
    "taskPreset": {"type": "object", "properties": {"id": {"$ref": "#/$defs/presetId"}, "label": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}, "executable": {"type": "string", "minLength": 1, "maxLength": 4096}, "args": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 4096}}, "timeoutMs": {"type": "integer", "minimum": 0, "maximum": 86400000}, "resources": {"$ref": "#/$defs/jobResources"}}, "required": ["id", "label", "executable", "args", "timeoutMs"], "additionalProperties": false},
    "workspace.list": {"type": "object", "maxProperties": 0},
    "workspace.get": {"type": "object", "properties": {"id": {"$ref": "#/$defs/wsId"}}, "required": ["id"], "additionalProperties": false},
    "workspace.tasks": {"type": "object", "properties": {"id": {"$ref": "#/$defs/wsId"}}, "required": ["id"], "additionalProperties": false},
    "workspace.remove": {"type": "object", "properties": {"id": {"$ref": "#/$defs/wsId"}}, "required": ["id"], "additionalProperties": false},
    "workspace.select": {"type": "object", "properties": {"id": {"$ref": "#/$defs/wsId"}}, "required": ["id"], "additionalProperties": false},
    "serviceDefinition": {"type": "object", "properties": {"id": {"$ref": "#/$defs/presetId"}, "executable": {"type": "string", "minLength": 1, "maxLength": 4096}, "args": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 4096}}, "restartPolicy": {"enum": ["never", "on-failure", "always"]}, "resources": {"$ref": "#/$defs/jobResources"}, "ports": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}}, "required": ["id", "executable", "args"], "additionalProperties": false},
    "workspace.create": {"type": "object", "properties": {"name": {"$ref": "#/$defs/workspaceName"}, "rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "taskPresets": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/taskPreset"}}, "resourceProfile": {"enum": ["unrestricted", "protected", "balanced", "performance", "custom", null]}, "services": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/serviceDefinition"}}}, "required": ["name", "rootId", "path"], "additionalProperties": false},
    "workspace.update": {"type": "object", "properties": {"id": {"$ref": "#/$defs/wsId"}, "name": {"$ref": "#/$defs/workspaceName"}, "rootId": {"$ref": "#/$defs/rootId"}, "path": {"$ref": "#/$defs/filePath"}, "taskPresets": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/taskPreset"}}, "resourceProfile": {"enum": ["unrestricted", "protected", "balanced", "performance", "custom", null]}, "services": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/serviceDefinition"}}}, "required": ["id"], "additionalProperties": false},
    "workspace.task.run": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "taskId": {"$ref": "#/$defs/presetId"}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["workspaceId", "taskId"], "additionalProperties": false},
    "workspace.git": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "subcommand": {"enum": ["status", "branch", "diff", "log"]}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["workspaceId", "subcommand"], "additionalProperties": false},
    "workspace.git.change": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "action": {"enum": ["fetch", "pull", "switch", "stage", "commit"]}, "branch": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._/][A-Za-z0-9._/-]*$"}, "paths": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/filePath"}}, "message": {"type": "string", "minLength": 1, "maxLength": 4096}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["workspaceId", "action"], "additionalProperties": false},
    "resource.capabilities": {"type": "object", "properties": {}, "additionalProperties": false},
    "resource.snapshot": {"type": "object", "properties": {}, "additionalProperties": false},
    "job.resource.get": {"type": "object", "properties": {"id": {"$ref": "#/$defs/jobId"}}, "required": ["id"], "additionalProperties": false},
    "job.history.list": {"type": "object", "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 50}}, "additionalProperties": false},
    "job.history.get": {"type": "object", "properties": {"id": {"$ref": "#/$defs/jobId"}}, "required": ["id"], "additionalProperties": false},
    "job.diagnostics.export": {"type": "object", "properties": {"id": {"$ref": "#/$defs/jobId"}, "includeOutput": {"type": "boolean"}}, "required": ["id"], "additionalProperties": false},
    "job.processes": {"type": "object", "properties": {"id": {"$ref": "#/$defs/jobId"}}, "required": ["id"], "additionalProperties": false},
    "serviceRef": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "serviceId": {"$ref": "#/$defs/presetId"}}, "required": ["workspaceId", "serviceId"], "additionalProperties": false},
    "workspace.service.list": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}}, "required": ["workspaceId"], "additionalProperties": false},
    "workspace.service.status": {"$ref": "#/$defs/serviceRef"},
    "workspace.service.health": {"$ref": "#/$defs/serviceRef"},
    "workspace.service.start": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "serviceId": {"$ref": "#/$defs/presetId"}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["workspaceId", "serviceId"], "additionalProperties": false},
    "workspace.service.stop": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "serviceId": {"$ref": "#/$defs/presetId"}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["workspaceId", "serviceId"], "additionalProperties": false},
    "workspace.service.restart": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "serviceId": {"$ref": "#/$defs/presetId"}, "clientRequestId": {"$ref": "#/$defs/requestId"}}, "required": ["workspaceId", "serviceId"], "additionalProperties": false},
    "workspace.service.logs": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "serviceId": {"$ref": "#/$defs/presetId"}, "stream": {"enum": ["stdout", "stderr"]}, "offset": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 65536}}, "required": ["workspaceId", "serviceId", "stream", "offset", "limit"], "additionalProperties": false},
    "workspace.service.ports": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}}, "required": ["workspaceId"], "additionalProperties": false},
    "workspace.service.proxy": {"type": "object", "properties": {"action": {"enum": ["open", "close", "list"]}, "listenAddress": {"type": "string", "minLength": 1, "maxLength": 45}, "listenPort": {"type": "integer", "minimum": 1024, "maximum": 65535}, "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}, "id": {"type": "string", "minLength": 1, "maxLength": 32}, "confirmLan": {"type": "boolean"}}, "required": ["action"], "additionalProperties": false},
    "workspace.backup.export": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "format": {"enum": ["zip", "tar.gz"]}, "includeSensitive": {"type": "boolean"}}, "required": ["workspaceId"], "additionalProperties": false},
    "workspace.backup.import": {"type": "object", "properties": {"workspaceId": {"$ref": "#/$defs/wsId"}, "backupId": {"type": "string", "minLength": 1, "maxLength": 80}, "paths": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 240}}, "overwrite": {"type": "boolean"}, "confirm": {"type": "boolean"}, "applyConfig": {"type": "boolean"}}, "required": ["workspaceId", "backupId"], "additionalProperties": false}
  }
}
